# Security Keys
# REPLACE THESE with strong, unique keys for production
SECRET_KEY=dev_secret_key_change_me
JWT_SECRET_KEY=dev_jwt_secret_key_change_me

# Database
# For local dev, SQLite is used by default if this is empty.
# For production (Render), set this to your PostgreSQL Internal URL.
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# Seeding
SEED_USER_PASSWORD=secure_password_for_seeded_users
